# Copy this file to .env and replace the sample values before starting Compose.

# SQL Server SA password.
SQL_SERVER_SA_PASSWORD=ChangeMe_Sql_123!

# Use a unique random key with at least 32 bytes.
JWT_SIGNING_KEY=replace-with-a-unique-random-signing-key-of-32-bytes-or-more

# Public and private Google reCAPTCHA v2 keys.
RECAPTCHA_SITE_KEY=6Ldu9dstAAAAAEssV2f88pzpXf_rc7zX3O9MOgWy
RECAPTCHA_SECRET_KEY=

# SMTP settings for email verification.
# For Gmail, use smtp.gmail.com and an app password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLE_SSL=true

# Set both values to provision the first database admin on API startup.
# The password must have at least 16 characters and is stored as a hash.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=